{
  "name": "darkwinter-desktop",
  "productName": "Darkwinter",
  "version": "1.0.0",
  "description": "Darkwinter for Windows and Mac",
  "author": "Darkwinter",
  "homepage": "https://darkwinter.lol",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "lol.darkwinter.app",
    "productName": "Darkwinter",
    "copyright": "© Darkwinter",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "offline.html", "build/icon.png"],
    "afterPack": "./build/after-pack.js",
    "publish": [{ "provider": "github", "owner": "darkwinterr", "repo": "darkwinter-desktop", "releaseType": "release" }],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.png",
      "artifactName": "Darkwinter-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Darkwinter",
      "artifactName": "Darkwinter-Setup.${ext}"
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "icon": "build/icon.png",
      "category": "public.app-category.social-networking",
      "identity": null,
      "hardenedRuntime": false,
      "darkModeSupport": true,
      "artifactName": "Darkwinter-Mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "Darkwinter",
      "artifactName": "Darkwinter-Mac-${arch}.${ext}",
      "contents": [{ "x": 150, "y": 190 }, { "x": 390, "y": 190, "type": "link", "path": "/Applications" }]
    }
  }
}
